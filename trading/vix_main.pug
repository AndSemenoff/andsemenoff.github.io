			+mli("en", "out", "https://cdn.cboe.com/api/global/us_indices/governance/Volatility_Index_Methodology_Cboe_Volatility_Index.pdf", "cboe.com", "VIX общая методология.", "pdf") 
			+mli("en", "out", "https://www.cboe.com/us/futures/market_statistics/settlement/", "cboe.com", "VIX официальные цены закрытия.", "icon")
			+mli("en", "out", "https://www.cboe.com/tradable_products/vix/vix_historical_data/", "cboe.com", "VIX официальные исторические данные.", "icon")
