extends ../layouts/html_layout.jade

block title
	title= site_title + " Блюз. Урок 1"

block scripts
	script(src="https://cdn.jsdelivr.net/npm/nexusui@2.1.5/dist/NexusUI.min.js")
	script(src="../js/div.prod.js" defer)
	
block content
	h2.font-effect-shadow-multiple Блюз. Урок 1
	article.grid-container
		div(class = "vextab-auto" width=680 scale=1.0 editor="false" editor-width=680 editor-height=330)
			| options space=20
			| tabstave clef = bass notation=true key=C time=4/4 tablature=false
			| notes :h (B@/3.E/3.D/4) $.top.$ $.Arial-20-bold.C7$ | (D/4.A/3.E@/3) $.top.$ $.Arial-20-bold.F7$| (D/4.B@/3.E/3) $.top.$ $.Arial-20-bold.C7$| (D/4.B@/3.E/3) $.top.$ $.Arial-20-bold.C7$|
			| options space=20
			| tabstave clef = bass time=4/4 notation=true tablature=false
			| notes :h (A/3.E@/3.D/4) $.top.$ $.Arial-20-bold.F7$ | (D/4.A/3.E@/3) $.top.$ $.Arial-20-bold.F7$ | (D/4.B@/3.E/3) $.top.$ $.Arial-20-bold.C7$ | (D/4.B@/3.E/3) $.top.$ $.Arial-20-bold.C7$ |
			| options space=20
			| tabstave clef = bass time=4/4 notation=true tablature=false
			| notes :h (B/3.F/3.E/4) $.top.$ $.Arial-20-bold.G7$ | (D/4.A/3.E@/3) $.top.$ $.Arial-20-bold.F7$ | (D/4.B@/3.E/3) $.top.$ $.Arial-20-bold.C7$ | (D/4.B@/3.E/3) $.top.$ $.Arial-20-bold.C7$ =|=
			| options space=25

		hr
		h3 C<sup>7</sup> (E<sub>3</sub>, Bb<sub>3</sub>, D<sub>4</sub>)
		div#piano1
		script
			| const piano1 = new Nexus.Piano('#piano1', {
			| 'size': [600, 150],
			| 'mode': 'button',
			| 'lowNote': 48, // Начинаем с ноты C3 (MIDI 48)
			| 'highNote': 72 // Заканчиваем на ноте C5 (MIDI 72)
			| });
			| const chordC7 = [52, 58, 62];
			| chordC7.forEach(note => {
			| const keyIndex = note - 48; 
			| piano1.toggleIndex(keyIndex, true);
			| });

		hr
		h3 F<sup>7</sup> (Eb<sub>3</sub>, A<sub>3</sub>, D<sub>4</sub>)
		div#piano2

		<script>
		| const piano2 = new Nexus.Piano('#piano2', {
		|	'size': [600, 150],
		|	'mode': 'button',
		|	'lowNote': 48, // Начинаем с ноты C3 (MIDI 48)
		|	'highNote': 72 // Заканчиваем на ноте C5 (MIDI 72)
		|});
		|// D4 = 62, A3 = 57, E3b = 53
		|        const chordF7 = [51, 62, 57];
		|
		|        // Программно нажимаем нужные клавиши
		|        chordF7.forEach(note => {
		|            // NexusUI требует индекс клавиши относительно lowNote
		|           const keyIndex = note - 48; 
		|            piano2.toggleIndex(keyIndex, true);
		|        });
		</script>

		hr
		h3 G<sup>7</sup> (F<sub>3</sub>, B<sub>3</sub>, E<sub>4</sub>)
		div#piano3
		<script>
		|        // Инициализация клавиатуры с использованием глобального объекта Nexus
		|        const piano3 = new Nexus.Piano('#piano3', {
		|            'size': [600, 150],
		|            'mode': 'button',
		|            'lowNote': 48, // Начинаем с ноты C3 (MIDI 48)
		|            'highNote': 72 // Заканчиваем на ноте C5 (MIDI 72)
		|        });
		|		//  B3 = 59, F3 = 53, E4 = 64
		|        const chordG7 = [59, 53, 64];
		|       // Программно нажимаем нужные клавиши
		|        chordG7.forEach(note => {
		|            // NexusUI требует индекс клавиши относительно lowNote
		|           const keyIndex = note - 48; 
		|            piano3.toggleIndex(keyIndex, true);
		|        });
		</script>